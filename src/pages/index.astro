---
import MkcLayout from '../layouts/MkcLayout.astro';
import CoppaScroll from '../components/CoppaScroll.astro';
import EsploraSezioni from '../components/EsploraSezioni.astro';
import { prossimaEdizione } from '../data/edizione';

const { edizione, anno, data } = prossimaEdizione;
---

<MkcLayout
  title={`Matenano Kings Cup ${anno}`}
  description={`Matenano Kings Cup ${anno}: la ${edizione}ª edizione del torneo di calcetto di Santa Vittoria in Matenano. Chi vuole essere il Re?`}
>
  <CoppaScroll edizione={edizione} anno={anno} data={data} />

  <section class="relative bg-[#030302] text-white px-4 py-20">
    <div class="absolute inset-0 pointer-events-none bg-[linear-gradient(to_right,rgba(255,234,0,0.03)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,234,0,0.03)_1px,transparent_1px)] bg-[size:30px_30px]"></div>
    <div class="relative max-w-7xl mx-auto space-y-12">
      <EsploraSezioni />
      <div class="text-center">
        <a href="/archivio/2026" class="font-mono text-xs uppercase tracking-widest text-[#ffea00]/80 hover:text-[#ffea00] transition-colors">
          🏆 Rivivi l'edizione 2026 →
        </a>
      </div>
    </div>
  </section>
</MkcLayout>
