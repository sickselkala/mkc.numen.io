---
import MkcLayout from '../layouts/MkcLayout.astro';
---

<MkcLayout title="Home | Matenano Kings Cup">
  {/* SFONDO TOTAL BLACK CON SHOCKWAVE DI LUCI DORATE MORBIDE MA VELOCI */}
  <main class="py-16 bg-[#030302] min-h-screen text-white px-4 relative overflow-hidden">
    
    {/* LIVELLO SPRAZZI ORO MULTIPLI CON EFFETTO FADE-IN CONTINUO */}
    <div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
      
      {/* 1. LAMA DI LUCE ORO ROTANTE VELOCE */}
      <div 
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[220%] h-[450px] opacity-45 mix-blend-color-dodge animate-[spin_8s_linear_infinite]" transform-gpu will-change-transform
        style="background: linear-gradient(135deg, transparent 40%, rgba(255,234,0,0.8) 50%, transparent 60%); filter: blur(55px);"
      ></div>

      {/* 2. SECONDA LAMA CONTRO-ROTANTE VELOCIZZATA */}
      <div 
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[200%] h-[350px] opacity-35 mix-blend-color-dodge animate-[spin_12s_linear_infinite]" transform-gpu will-change-transform 
        style="background: linear-gradient(45deg, transparent 42%, rgba(212,175,55,0.7) 50%, transparent 58%); filter: blur(45px); animation-direction: reverse;"
      ></div>

      {/* 3. SPRAZZO IN ALTO A SINISTRA */}
      <div 
        class="absolute w-[650px] h-[650px] rounded-full mix-blend-color-dodge animate-[pulse_2.5s_ease-in-out_infinite]" transform-gpu will-change-transform
        style="
          top: -20%;
          left: -15%;
          background: radial-gradient(circle, rgba(255,234,0,0.3) 0%, rgba(212,175,55,0.08) 40%, transparent 70%);
        "
      ></div>

      {/* 4. SPRAZZO IN BASSO A DESTRA */}
      <div 
        class="absolute w-[650px] h-[650px] rounded-full mix-blend-color-dodge animate-[pulse_3s_ease-in-out_infinite]" transform-gpu will-change-transform
        style="
          bottom: -20%;
          right: -15%;
          background: radial-gradient(circle, rgba(255,215,0,0.25) 0%, rgba(234,179,8,0.05) 45%, transparent 70%);
          animation-delay: 1s;
        "
      ></div>

      {/* 5. FARO LATERALE AD ALTA VELOCITÀ */}
      <div 
        class="absolute w-[500px] h-[500px] rounded-full mix-blend-screen opacity-40 animate-[bounce_5s_infinite]" transform-gpu will-change-transform
        style="
          top: 25%;
          right: -10%;
          background: radial-gradient(circle, rgba(255,234,0,0.3) 0%, transparent 65%);
          filter: blur(30px);
        "
      ></div>

      {/* 6. SPRAZZO IN ALTO A DESTRA */}
      <div 
        class="absolute w-[450px] h-[450px] rounded-full mix-blend-color-dodge animate-[pulse_2s_ease-in-out_infinite]" transform-gpu will-change-transform
        style="
          top: -10%;
          right: -5%;
          background: radial-gradient(circle, rgba(250,204,21,0.2) 0%, transparent 65%);
          animation-delay: 0.5s;
        "
      ></div>

      {/* 7. SPRAZZO IN BASSO A SINISTRA */}
      <div 
        class="absolute w-[450px] h-[450px] rounded-full mix-blend-screen animate-[pulse_3.5s_ease-in-out_infinite]" transform-gpu will-change-transform
        style="
          bottom: -10%;
          left: -5%;
          background: radial-gradient(circle, rgba(234,179,8,0.18) 0%, transparent 65%);
          animation-delay: 1.5s;
        "
      ></div>

      {/* 8. BAGLIORE CENTRALE DI SFONDO */}
      <div 
        class="absolute top-[20%] left-[15%] w-[650px] h-[650px] rounded-full mix-blend-screen animate-[pulse_4s_ease-in-out_infinite]" transform-gpu will-change-transform
        style="
          background: radial-gradient(circle, rgba(255,234,0,0.15) 0%, transparent 60%);
          filter: blur(40px);
          animation-delay: 0.7s;
        "
      ></div>

      {/* STRUTTURA GEOMETRICA DI RIFRAZIONE ACCESA */}
      <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,234,0,0.03)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,234,0,0.03)_1px,transparent_1px)] bg-[size:30px_30px]" transform-gpu will-change-transform></div>
    </div>

    {/* CONTENUTO CENTRATO */}
    <div class="max-w-7xl mx-auto space-y-12 relative z-10">
      
      {/* SEZIONE LOGO PRINCIPALE E TITOLO */}
      <div class="flex flex-col items-center justify-center pt-8 text-center space-y-6">
        <div class="relative group">
          {/* Alone giallo morbido dietro l'immagine */}
          <div class="absolute inset-0 bg-[#ffea00]/30 blur-[45px] rounded-full opacity-70 group-hover:opacity-100 group-hover:blur-[35px] transition-all duration-500"></div>
          
          <img 
            src="/assets/mkc26.png" 
            alt="Matenano Kings Cup 2026"
            class="w-40 md:w-56 h-auto object-contain filter drop-shadow-[0_15px_30px_rgba(0,0,0,0.95)] relative z-10"
          />
        </div>

        {/* DESCRIZIONE E ANTEPRIMA TESTO */}
        <div class="max-w-4xl mx-auto px-4 pt-2 text-center flex flex-col items-center">
          
          {/* TITOLO SPEZZATO CORRETTAMENTE */}
          <h1 class="text-regale block py-2 leading-none">
            <span class="block w-full text-3xl md:text-5xl lg:text-6xl text-shine-silver-gold tracking-[0.05em] font-bold pb-4">
              Chi vuole essere il
            </span>
            <span class="block w-full text-7xl md:text-9xl lg:text-[10rem] text-shine-re tracking-[0.02em] font-extrabold filter drop-shadow-[0_0_50px_rgba(255,234,0,0.7)] pt-2">
              Re?
            </span>
          </h1>
          
          <p class="text-sm md:text-base font-sans text-white/85 font-light leading-relaxed drop-shadow-[0_2px_4px_rgba(0,0,0,0.7)] pt-8 max-w-2xl mx-auto">
            Numerosi sfidanti, colpi di scena e una sola corona. Ripercorri l'intera edizione 2026 fino alla Finalissima del 9 luglio.
          </p>

          {/* SCRITTA AD EFFETTO INGRANDITA E ENTRAMBE IN ORO */}
          <div class="pt-8 space-y-2 text-sm md:text-base lg:text-lg font-mono uppercase tracking-[0.3em] text-center select-none">
            <p class="text-[#d4af37]/90 font-medium drop-shadow-[0_2px_4px_rgba(0,0,0,0.6)]">
              Non è solo calcetto
            </p>
            <p class="text-[#ffea00] font-black tracking-[0.35em] filter drop-shadow-[0_0_15px_rgba(255,234,0,0.5)] text-base md:text-lg lg:text-xl pt-0.5">
              È la Matenano Kings Cup
            </p>
          </div>
        </div>
      </div>

      <hr class="border-white/5 max-w-xl mx-auto my-6" />

      {/* SEZIONE PRIMARY: POST-TORNEO — IL CAMPIONE DELL'EDIZIONE 2026 */}
      <div class="bg-[#121210]/95 backdrop-blur-md border border-[#ffea00]/40 rounded-3xl p-8 md:p-12 space-y-8 text-center shadow-[0_0_50px_rgba(255,234,0,0.15)] max-w-4xl mx-auto transform hover:scale-[1.01] transition-transform duration-300">
        <div class="flex flex-col items-center space-y-4">
          <span class="font-mono text-sm uppercase tracking-[0.2em] text-black font-black bg-[#ffea00] px-4 py-1.5 rounded-full inline-flex items-center gap-2 shadow-[0_0_20px_rgba(255,234,0,0.5)]">
            🏆 Edizione 2026 Conclusa
          </span>

          <div class="relative mt-2">
            <div class="absolute inset-0 bg-[#ffea00]/25 blur-[50px] rounded-full opacity-80"></div>
            <img 
              src="/assets/barigloo.png" 
              alt="Bar Igloo Campione Matenano Kings Cup 2026" 
              class="w-32 md:w-44 h-auto object-contain relative z-10 filter drop-shadow-[0_12px_28px_rgba(0,0,0,0.9)]"
            />
          </div>

          <div class="space-y-2">
            <p class="font-mono text-xs uppercase tracking-[0.3em] text-[#d4af37]">Campioni Matenano Kings Cup 2026</p>
            <h2 class="text-4xl md:text-6xl font-display font-black uppercase tracking-wider text-shine-silver-gold pb-1">
              Bar Igloo
            </h2>
          </div>

          <p class="text-base md:text-lg font-mono text-zinc-300 font-medium max-w-2xl mx-auto leading-relaxed">
            Si è chiusa la seconda edizione: dopo una cavalcata straordinaria il <span class="text-[#ffea00]">Bar Igloo</span> alza la coppa, superando in Finalissima l'<span class="text-[#ffea00]">Edil Pennello Fc</span>. Rivivi l'intero tabellone, le classifiche definitive e la corsa per la scarpa d'oro.
          </p>

          <div class="flex flex-wrap items-center justify-center gap-3 pt-2 text-xs md:text-sm font-mono">
            <span class="px-4 py-2 rounded-xl bg-white/5 border border-white/10 text-white/80">🥈 Edil Pennello Fc</span>
            <span class="px-4 py-2 rounded-xl bg-white/5 border border-white/10 text-white/80">🥉 Sold Out</span>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
          <a 
            href="/classifiche" 
            class="flex items-center justify-center gap-4 px-10 py-5 bg-[#ffea00] text-black font-display font-black uppercase text-base tracking-widest rounded-2xl hover:bg-white hover:-translate-y-1 transition-all shadow-[0_0_30px_rgba(255,234,0,0.4)] group w-full sm:w-auto"
          >
            <span>Risultati e Classifiche</span>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-6 h-6 group-hover:translate-x-2 transition-transform">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
            </svg>
          </a>
          <a 
            href="/albo" 
            class="flex items-center justify-center gap-3 px-8 py-5 bg-zinc-900/80 text-[#ffea00] border border-[#ffea00]/30 font-display font-black uppercase text-sm tracking-widest rounded-2xl hover:bg-[#ffea00]/10 hover:-translate-y-1 transition-all w-full sm:w-auto"
          >
            <span>Albo d'Oro</span>
          </a>
        </div>

        <div class="pt-6">
          <p class="text-xs font-mono text-white/50 uppercase tracking-widest">
            📍 Campo Sportivo L. Paolucci, Santa Vittoria in Matenano
          </p>
        </div>
      </div>

      {/* SEZIONE ESPLORA IL TORNEO E LE SQUADRE */}
      <div id="esplora" class="space-y-10 pt-10">
        <div class="text-center">
          <span class="font-mono text-xs uppercase tracking-widest text-[#ffea00]/70 font-bold">L'UNIVERSO MKC</span>
          <h2 class="text-3xl md:text-4xl font-display font-black uppercase tracking-wider mt-1 drop-shadow-sm">
            Esplora le Sezioni
          </h2>
          <div class="w-16 h-1 bg-[#ffea00] mt-4 mx-auto"></div>
        </div>

        {/* GRIGLIA A 4 BOX (Incluse News e Squadre) */}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6 max-w-6xl mx-auto">
          
          {/* BOX NEWS - Evidenziato */}
          <div class="bg-gradient-to-b from-zinc-900 to-black backdrop-blur-md border border-[#ffea00]/20 rounded-2xl p-6 flex flex-col justify-between space-y-6 hover:border-[#ffea00]/60 hover:shadow-[0_0_30px_rgba(255,234,0,0.1)] transition-all group">
            <div class="space-y-3">
              <div class="w-10 h-10 bg-[#ffea00]/10 rounded-xl flex items-center justify-center text-xl mb-4">🎙️</div>
              <h3 class="text-lg font-display font-black uppercase tracking-wider text-white group-hover:text-[#ffea00] transition-colors">
                News e Comunicati
              </h3>
              <p class="text-xs font-mono text-zinc-400 leading-relaxed">
                Riepiloghi delle giornate, comunicati ufficiali e il racconto completo dell'edizione 2026.
              </p>
            </div>
            <a href="/news" class="w-full text-center py-3 bg-zinc-900 text-[#ffea00] border border-[#ffea00]/20 group-hover:bg-[#ffea00] group-hover:text-black font-display font-black uppercase text-[10px] tracking-widest rounded-xl transition-all">
              Leggi le Notizie
            </a>
          </div>

          {/* BOX SQUADRE */}
          <div class="bg-gradient-to-b from-zinc-900 to-black backdrop-blur-md border border-white/5 rounded-2xl p-6 flex flex-col justify-between space-y-6 hover:border-white/20 transition-all group">
            <div class="space-y-3">
              <div class="w-10 h-10 bg-white/5 rounded-xl flex items-center justify-center text-xl mb-4 text-[#ffea00]">🛡️</div>
              <h3 class="text-lg font-display font-black uppercase tracking-wider text-white">
                Le Squadre
              </h3>
              <p class="text-xs font-mono text-zinc-400 leading-relaxed">
                Scopri le formazioni ufficiali dell'edizione 2026, lo staff tecnico e i giocatori scesi in campo.
              </p>
            </div>
            <a href="/squadre" class="w-full text-center py-3 bg-zinc-900 text-white/80 group-hover:bg-white/10 group-hover:text-white font-display font-black uppercase text-[10px] tracking-widest rounded-xl transition-all border border-white/5">
              Esplora Rose
            </a>
          </div>

          {/* BOX REGOLAMENTO */}
          <div class="bg-gradient-to-b from-zinc-900 to-black backdrop-blur-md border border-white/5 rounded-2xl p-6 flex flex-col justify-between space-y-6 hover:border-white/20 transition-all group">
            <div class="space-y-3">
              <div class="w-10 h-10 bg-white/5 rounded-xl flex items-center justify-center text-xl mb-4">🃏</div>
              <h3 class="text-lg font-display font-black uppercase tracking-wider text-white">
                Carte Speciali
              </h3>
              <p class="text-xs font-mono text-zinc-400 leading-relaxed">
                Il format speciale del torneo: esplora i poteri, i bonus e i malus tattici che cambiano le sorti dei match.
              </p>
            </div>
            <a href="/iltorneo" class="w-full text-center py-3 bg-zinc-900 text-white/80 group-hover:bg-white/10 group-hover:text-white font-display font-black uppercase text-[10px] tracking-widest rounded-xl transition-all border border-white/5">
              Il Regolamento
            </a>
          </div>

          {/* BOX ALBO D'ORO */}
          <div class="bg-gradient-to-b from-zinc-900 to-black backdrop-blur-md border border-white/5 rounded-2xl p-6 flex flex-col justify-between space-y-6 hover:border-white/20 transition-all group">
            <div class="space-y-3">
              <div class="w-10 h-10 bg-white/5 rounded-xl flex items-center justify-center text-xl mb-4 text-[#ffea00]">🏆</div>
              <h3 class="text-lg font-display font-black uppercase tracking-wider text-white">
                Albo d'Oro
              </h3>
              <p class="text-xs font-mono text-zinc-400 leading-relaxed">
                Ripercorri la storia del torneo. I campioni passati, i record e le leggende che hanno alzato la coppa.
              </p>
            </div>
            <a href="/albo" class="w-full text-center py-3 bg-zinc-900 text-white/80 group-hover:bg-white/10 group-hover:text-white font-display font-black uppercase text-[10px] tracking-widest rounded-xl transition-all border border-white/5">
              Vedi Vincitori
            </a>
          </div>

        </div>
      </div>

    </div>
  </main>
</MkcLayout>

<style is:inline>
  @import url('https://fonts.googleapis.com/css2?family=Spectral+SC:wght@700;800&display=swap');

  .text-regale {
    font-family: 'Spectral SC', Georgia, serif;
  }

  @keyframes shine {
    0% { background-position: -200% center; }
    100% { background-position: 200% center; }
  }

  .text-shine-silver-gold {
    background: linear-gradient(
      110deg,
      #d4af37 10%,
      #e5e7eb 30%,
      #ffffff 50%,
      #e5e7eb 70%,
      #d4af37 90%
    );
    background-size: 200% auto;
    color: transparent;
    -webkit-background-clip: text;
    background-clip: text;
    animation: shine 6s linear infinite;
  }

  .text-shine-re {
    background: linear-gradient(
      110deg,
      #ffea00 10%,
      #fffeb3 40%,
      #ffffff 50%,
      #fffeb3 60%,
      #ffea00 90%
    );
    background-size: 200% auto;
    color: transparent;
    -webkit-background-clip: text;
    background-clip: text;
    animation: shine 3.5s linear infinite;
  }
</style>