    if (sorted.length === 2) {
      match34 = sorted[0]; 
      match12 = sorted[1]; 
    } else if (sorted.length === 1) {
      if (sorted[0].orario.startsWith('22')) match12 = sorted[0];
      else match34 = sorted[0];
